# העתק: cp .env.example .env — את .env לא מעלים ל-git

# Project URL + anon public key: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://zlixzgfeqvbmcegsjfge.supabase.co
VITE_SUPABASE_ANON_KEY=

# בסיס כתובת האתר בפרודקשן (Vercel) — קישורי כרטיס /ticket/… וכו׳
VITE_PUBLIC_FRONTEND_URL=https://tchernichovsky-5-party.vercel.app

# Edge Functions (Supabase → Secrets): אותו ערך; send-whatsapp מקבל VITE_* או PUBLIC_*
PUBLIC_FRONTEND_URL=https://tchernichovsky-5-party.vercel.app

# Twilio — Edge Functions (send-whatsapp, submit-whatsapp-template, twilio-whatsapp-webhook, …). לא ב-Vite.
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_WHATSAPP_FROM=whatsapp:+1…
#
# כתובת מלאה של twilio-whatsapp-webhook — חייבת להתאים ל-URL ב-Twilio Console (לאימות X-Twilio-Signature).
# גם ב-Supabase → Edge Functions → Secrets (לא רק קובץ .env מקומי).
TWILIO_WEBHOOK_PUBLIC_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/twilio-whatsapp-webhook
